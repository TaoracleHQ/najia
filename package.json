{
	"name": "@taoracle/najia",
	"version": "0.1.0",
	"description": "六爻纳甲排盘 —— TypeScript implementation of Liu Yao / Na Jia hexagram divination casting",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE.md"
	],
	"sideEffects": false,
	"keywords": [
		"najia",
		"liuyao",
		"iching",
		"yijing",
		"divination",
		"六爻",
		"纳甲",
		"周易"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TaoracleHQ/najia.git"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bun test",
		"check": "biome check",
		"lint": "biome lint",
		"format": "biome format --write",
		"prepublishOnly": "bun run typecheck && bun test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/bun": "latest",
		"typescript": "^5.7.2"
	},
	"dependencies": {
		"tyme4ts": "^1.5.2"
	},
	"homepage": "https://github.com/TaoracleHQ/najia#readme",
	"bugs": {
		"url": "https://github.com/TaoracleHQ/najia/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	}
}
